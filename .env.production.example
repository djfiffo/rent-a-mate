# Example for `docker compose --env-file .env.production -f docker-compose.prod.yml`.
# Copy to an untracked .env.production, replace every placeholder, and restrict
# access to this file. Compose interpolation alone does not pass a variable to
# the API container; docker-compose.prod.yml lists the required pass-throughs.

# Database and MinIO credentials. Use unique strong values; the Compose file
# builds DATABASE_URL using POSTGRES_PASSWORD and its internal postgres host.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_STRONG_MINIO_SECRET_KEY

# JWT signing secrets must be long, random, distinct values. The socket ticket
# secret is separate from the access-token secret; tickets are single-use.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_REFRESH_SECRET
JWT_SOCKET_TICKET_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SOCKET_TICKET_SECRET
SOCKET_TICKET_TTL_SECONDS=60

# Exact frontend HTTPS origin(s), comma-separated if more than one is used.
# The Socket.IO gateway also reads this value. Do not use '*' in production.
CORS_ORIGIN=https://app.example.com

# The Compose API port is bound to an internal address. Publish the API through
# an HTTPS reverse proxy at api.example.com and allow WebSocket upgrades there.

# Stripe LIVE-mode server credentials. Keep these off the frontend and out of
# git. Configure a live HTTPS webhook endpoint at
# https://api.example.com/api/v1/webhooks/stripe; use that endpoint's secret.
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Optional: backend defaults to its pinned API version if this is omitted.
STRIPE_API_VERSION=2026-08-26.dahlia

# Current production Compose still runs the seed command on startup; this
# variable is required there. Review seed behavior before deploying real data.
DEMO_ACCOUNT_PASSWORD=REPLACE_WITH_STRONG_DEMO_PASSWORD
